SLACK_BOT_TOKEN=your-slack-bot-token
SLACK_SIGNING_SECRET=your-slack-signing-secret
TOQAN_API_KEY=your-toqan-api-key
GOOGLE_CREDENTIALS_JSON=base64-encoded-service-account-json

# Um canal por EPS (report, cobrança, compromissos e MOP de cada EPS ficam só no canal dela)
EPS_CHANNELS=AeC:C0C9F5BLVN1,CSU:C0C9L8NRPPC
# Canal interno do iFood com report consolidado (AeC + CSU). Vazio = desligado
CONSOLIDATED_CHANNEL=
# Outros canais internos onde a Lyra responde com visão completa (vírgula)
INTERNAL_CHANNELS=
# Quem pode usar DM (visão completa). Vazio = só o ALERT_CHANNEL, se for usuário
DM_ALLOWED_USERS=
# Canal do fluxo "Reportar Oráculo" (Excel de MOP é lido sozinho). Vazio = desligado
MOP_FLOW_CHANNEL=
# Todo agente com conexão própria ao Databricks (API key do Toqan de cada um): Nome:chave,Nome:chave
MONITORED_AGENTS=Lyra Indicadores:<chave>,Lyra Qualidade:<chave>,Nexus:<chave>,Vera:<chave>,ClubIA:<chave>
# Agentes que usam o mesmo token do Databricks (aparecem no alerta de token)
SHARED_TOKEN_AGENTS=Nexus,Vera,ClubIA
# Horários dos testes (sempre no minuto 30)
AGENT_CHECK_HOURS=7,11,15,19
# Token do Databricks: validade em dias e data da última troca (depois disso, basta mandar "troquei o token" na DM)
DATABRICKS_TOKEN_VALIDITY_DAYS=7
DATABRICKS_TOKEN_RENEWED=2026-10-15
# Quem recebe alertas técnicos (usuário e/ou canal, vírgula)
ALERT_CHANNEL=U0B1E6UJ8P8,C0870JJ5G79

# Usado só quando EPS_CHANNELS está vazio (modo antigo, um canal só)
DAILY_REPORT_CHANNEL=C0BF6JVFG7N
# IDs de canal liberados para upload do MOP (vírgula). Vazio = canais de EPS e internos
MOP_ALLOWED_CHANNELS=
# Planilha da Lyra: Compromissos, Estado Lyra, MOP backup
LYRA_SPREADSHEET_ID=1Up11UQ1j0h9t8KW276AxJPGfEsShs9AsUztF5PAmyyE
# Planilha do MOP oficial e a aba "MOP Consolidado" (gid)
MOP_SPREADSHEET_ID=1cy23m4iN0D7vEiJbbAw9hRpUtaHgGuRew_fgAUz_l14
MOP_WORKSHEET_GID=464304384
# Token para /debug/status (header X-Debug-Token). Vazio = endpoint desligado
DEBUG_TOKEN=

PORT=3000

# Chamados de moedas: canal do Fluxo Owners CX, canal do Rewards e webhook do fluxo Rewards Engine CX Support
OWNERS_FLOW_CHANNEL=
REWARDS_CHANNEL=C08M93FKB63
REWARDS_WEBHOOK_URL=
REWARDS_PROBLEM_TYPES=Missão concluída, mas moedas não creditadas

# Plan de TMA por célula (tempo único em s / média de interações). Vazio = padrão da aba PLAN de setembro
# 0 = tira o TMA do report e da cobrança (ex.: enquanto a query não bate com a planilha)
TMA_IN_REPORT=1
TMA_PLAN=
# Esteira de impacto automática depois do report (1 = liga). Sob demanda funciona sempre
ESTEIRA_ENABLED=0
# Pergunta de causa: se o efeito mix responde por esta fração da queda (e a performance ficou estável), não cobra plano
MIX_DOMINANT_SHARE=0.8
# Segundos que a Lyra espera antes de responder na thread (junta mensagens seguidas)
LIVE_REPLY_DELAY_SECONDS=60
# Status de hora em hora das EPSs ("Controle de SLA ..."): canal de indicadores de cada EPS (a Lyra precisa estar no canal)
# Canais extras de conversa com recorte de EPS (ex.: teste com alguém da EPS). Sem report; pode repetir a EPS.
EPS_EXTRA_CHANNELS=AeC:C0CAK0E334H
STATUS_CHANNELS=CSU:C0XXXXXXX
# Meta de SLA (%) por fila; sem meta configurada a Lyra não cobra SLA
SLA_METAS=
STATUS_REPLY_DELAY_SECONDS=90
# Fase de testes (padrão 1): lê o canal real, mas responde no canal de testes da EPS (EPS_CHANNELS), sem marcar ninguém.
# 0 = responde na própria thread da EPS marcando quem postou.
STATUS_SHADOW=1
# Leitura dos prints de Volume/Produtividade (0 = desligada). Falha técnica só vira alerta, nunca vai para a EPS.
PRINT_READING=1
